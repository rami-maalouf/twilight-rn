{
  "expo": {
    "name": "Twilight",
    "slug": "twilight",
    "scheme": "twilight",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00D4FF",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-document-picker",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1520"
        }
      ],
      "expo-status-bar",
      [
        "./src/widgets/android-plugin.cjs",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TwilightSleepStatus",
              "displayName": "Sleep status",
              "description": "Your saved sleep status and nightly target. Open Twilight to start or finish sleep.",
              "ios": null,
              "android": {
                "minWidth": 180,
                "minHeight": 210,
                "targetCellWidth": 2,
                "targetCellHeight": 3,
                "resizeMode": "horizontal",
                "initialLayout": "src/widgets/sleep-status.android.tsx"
              }
            },
            {
              "name": "TwilightSleepOverview",
              "displayName": "Sleep overview",
              "description": "Latest recorded sleep and the last seven calendar days, using your Twilight sleep logs.",
              "ios": null,
              "android": {
                "minWidth": 300,
                "minHeight": 210,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "horizontal",
                "initialLayout": "src/widgets/sleep-overview.android.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/with-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "studio.orbitlabs.twilight.rn",
      "adaptiveIcon": {
        "backgroundColor": "#0A1520",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "ios": {
      "bundleIdentifier": "studio.orbitlabs.twilight.rn",
      "buildNumber": "1"
    },
    "icon": "./assets/icon.png"
  }
}
